# Copy to config.env and edit. Source it before running: set -a; . ./config.env; set +a
# NOTHING here is a secret value. Key material is only ever referenced by PATH.

# --- the model (your LAN GPU box; OpenAI-compatible) ---
SEAMS_LLM_BASE_URL=http://CHANGE-ME:8000/v1
SEAMS_LLM_MODEL=CHANGE-ME
SEAMS_LLM_CTX=262144
SEAMS_LLM_MAX_OUT=2048
SEAMS_LLM_TIMEOUT=300
# SEAMS_LLM_KEY_FILE=/absolute/path/to/a/file/holding/the/endpoint/token   (path only; optional)
# Qwen3-family: switch thinking off for faster attack turns if your server honours it:
# SEAMS_LLM_EXTRA_JSON={"chat_template_kwargs": {"enable_thinking": false}}
# Only after `probe` says tool_calling is true:
# SEAMS_USE_TOOLS=1

# --- the target ---
SEAMS_TARGET=stub            # stub | helper
# SEAMS_ZEPHYR_DIR=/path/to/zephyr   (default: ./zephyr-src inside the kit)
# SEAMS_OUT_DIR=/path/for/results    (default: ./out)

# --- testnet (phase 2, not used by this kit) ---
# ZEPHYR_AGENT_KEY_PATH=...   node signing key: PATH only, contents are never read by this kit
# Open Payments wallet key paths are injected by the executor adapter on the Mac, never here.

  "wallets": {
   "key:D": "https://wallet.example/d",
   "key:M": "https://wallet.example/m",
   "key:A": "https://wallet.example/a",
   "key:B": "https://wallet.example/b",
   "key:C": "https://wallet.example/c"
  }
 },
 "cases": [
  {
   "name": "spec worked example: 500 with D 40%, M 25%, P 10% pass-through",
   "request": {
    "op": "quote_route",
    "work": "sha256:fx-derived",
    "amount": {
     "value": 500,
     "asset_code": "USD",
     "asset_scale": 2
    },
    "event_ref": "e1"
   },
   "expect": {
    "manifest": {
     "payer_retained": 175,
     "legs": [
      {
       "beneficiary": "key:D",
       "amount": 180
      },
      {
       "beneficiary": "key:P",
       "amount": 20
      },
      {
       "beneficiary": "key:M",
       "amount": 125
      }
     ],
     "depth": 1
    }
   }
  },
  {
   "name": "spec tie example: 3 units across three 25% shares",

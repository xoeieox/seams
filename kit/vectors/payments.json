    "creator": "key:I",
    "parents": [
     "sha256:fx-g2"
    ]
   },
   "sha256:fx-bare": {
    "creator": "key:B"
   }
  },
  "routing_terms": [
   {
    "subject": "sha256:fx-derived",
    "beneficiary": "key:D",
    "share_bps": 4000,
    "scope": "standing"
   },
   {
    "subject": "sha256:fx-derived",
    "beneficiary": "key:M",
    "share_bps": 2500,
    "scope": "standing"
   },
   {
    "subject": "sha256:fx-parent",
    "beneficiary": "key:P",
    "share_bps": 1000,
    "scope": "standing"
   },
   {
    "subject": "sha256:fx-tie",
    "beneficiary": "key:A",
    "share_bps": 2500
   },
   {
    "subject": "sha256:fx-tie",
    "beneficiary": "key:B",
    "share_bps": 2500
   },
   {
    "subject": "sha256:fx-tie",
    "beneficiary": "key:C",
    "share_bps": 2500
   },
   {
    "subject": "sha256:fx-g1",
    "beneficiary": "key:G",
    "share_bps": 1000
   },
   {
    "subject": "sha256:fx-g2",
    "beneficiary": "key:H",
    "share_bps": 1000
   },
   {
    "subject": "sha256:fx-g3",
    "beneficiary": "key:I",
    "share_bps": 5000
   }
